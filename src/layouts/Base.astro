---
import SEO from "../components/SEO.astro";

interface Props {
	title?: string;
	description?: string;
	type?: "website" | "profile" | "article";
	publishedTime?: Date;
	jsonLd?: Record<string, unknown>;
	markdownUrl?: string;
}

const {
	title,
	description = "İsmail Karslı is a full-stack software developer specializing in TypeScript, Node.js, and Vue. Personal website, blog posts, and projects.",
	type = "website",
	publishedTime,
	jsonLd,
	markdownUrl,
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#000000" />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="apple-touch-icon" href="/images/apple-touch-icon.png" />
		<SEO
			title={title}
			description={description}
			type={type}
			publishedTime={publishedTime}
			jsonLd={jsonLd}
			markdownUrl={markdownUrl}
		/>
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,300..800;1,300..800&display=swap"
		/>
	</head>
	<body>
		<header>
			<a href="/">İsmail Karslı</a>
			<a href="/blog/">Blog</a>
			<a href="/about/">About</a>
		</header>
		<main>
			<slot />
		</main>
	</body>
</html>

<style is:global>
	:root {
		--text-color: #f5f5f5;
		--muted-color: #a3a3a3;
	}
	body {
		font-family: "Open Sans", sans-serif;
		font-optical-sizing: auto;
		background-color: #000;
		color: var(--text-color);
		margin: 0;
		line-height: 1.7;
	}
	a {
		color: inherit;
	}
	header,
	main {
		max-width: 42rem;
		margin: 0 auto;
		padding: 0 1.25rem;
	}
	header {
		padding-top: 2rem;
		padding-bottom: 1rem;
		display: flex;
		gap: 1.5rem;
		a {
			text-decoration: none;
			color: var(--muted-color);
		}
		a:hover {
			color: var(--text-color);
		}
	}
	main {
		padding-bottom: 4rem;
	}
	h1 {
		font-size: 2.25rem;
		font-weight: 600;
		letter-spacing: -0.02em;
		line-height: 1.2;
		margin: 1.5rem 0 0.5rem;
	}
	time {
		color: var(--muted-color);
		font-size: 0.9rem;
	}
	article {
		img {
			max-width: 100%;
		}
		pre {
			overflow-x: auto;
			padding: 1rem;
			border-radius: 0.375rem;
		}
		code {
			font-size: 0.9em;
		}
		table {
			width: 100%;
			border-collapse: collapse;
			font-size: 0.95rem;
		}
		th,
		td {
			padding: 0.4rem 0.75rem;
			border-bottom: 1px solid #404040;
		}
		blockquote {
			margin-left: 0;
			padding-left: 1rem;
			border-left: 3px solid #404040;
			color: var(--muted-color);
		}
	}
</style>
