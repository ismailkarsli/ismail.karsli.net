---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<title>İsmail Karslı</title>
		<meta name="description" content="A personal web site no one cares." />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#000000" />
		<meta name="og:type" content="website" />
		<meta name="og:title" content="İsmail Karslı" />
		<meta name="og:site_name" content="İsmail Karslı" />
		<meta name="og:url" content="https://ismail.karsli.net" />
		<meta name="og:locale" content="en_US" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" href="/images/apple-touch-icon.png" />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,300..800;1,300..800&display=swap"
		/>
	</head>

	<body>
		<main>
			<h1>İsmail Karslı</h1>
			<p class="subheading">Software Developer</p>
			<section class="blog">
				{
					latest && (
						<a class="latest" href={`/blog/${latest.id}/`}>
							<span class="latest-label">
								Latest post ·{" "}
								<time datetime={latest.data.date.toISOString()}>
									{formatDate(latest.data.date)}
								</time>
							</span>
							<span class="latest-title">{latest.data.title}</span>
						</a>
					)
				}
				<nav class="more">
					<a href="/blog/">All posts <span aria-hidden="true">→</span></a>
					<a href="/about/">About <span aria-hidden="true">→</span></a>
				</nav>
			</section>
		</main>
		<footer>
			<a class="mail" href="mailto:iletisim@ismail.karsli.net">iletisim@ismail.karsli.net</a>
			<ul class="socials">
				{
					socials.map((link) => (
						<li>
							<a
								href={link.href}
								title={link.label}
								aria-label={link.label}
								target="_blank"
								rel="me noopener"
							>
								<svg viewBox={link.viewBox} aria-hidden="true">
									<path fill="currentColor" d={link.path} />
								</svg>
							</a>
						</li>
					))
				}
			</ul>
		</footer>
		<style is:inline>
			:root {
				--text-color: #f5f5f5;
				--muted-color: #a3a3a3;
				--border-color: rgba(255, 255, 255, 0.14);
				color-scheme: dark;
			}
			@media screen and (max-width: 480px) {
				html {
					font-size: 13px;
				}
			}

			body {
				font-family: "Open Sans", sans-serif;
				font-optical-sizing: auto;
				margin: 0;
				background-color: #000;
				color: var(--text-color);
				min-height: 100vh;
				min-height: 100dvh;
				display: flex;
				flex-direction: column;
			}

			body::before {
				content: "";
				position: fixed;
				inset: 0;
				z-index: -1;
				pointer-events: none;
				background-image:
					linear-gradient(rgba(255, 255, 255, 0.06) 1px, transparent 1px),
					linear-gradient(90deg, rgba(255, 255, 255, 0.06) 1px, transparent 1px);
				background-size: 48px 48px;
				mask-image: radial-gradient(
					ellipse 70% 60% at 50% 45%,
					#000 20%,
					transparent 75%
				);
			}

			main {
				flex: 1;
				padding: 4rem 1.25rem 2rem;
				display: flex;
				flex-direction: column;
				justify-content: center;
				align-items: center;
				text-align: center;

				> * {
					animation: rise 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) both;
				}
				> :nth-child(2) {
					animation-delay: 0.08s;
				}
				> :nth-child(3) {
					animation-delay: 0.16s;
				}
			}

			h1 {
				font-size: 4.5rem;
				font-weight: 700;
				letter-spacing: -0.04em;
				line-height: 1.05;
				margin: 0;
				background: linear-gradient(180deg, #fff 30%, #9a9a9a);
				-webkit-background-clip: text;
				background-clip: text;
				color: transparent;
			}

			.subheading {
				font-size: 1.35rem;
				font-weight: 400;
				color: var(--muted-color);
				margin: 0.75rem 0 0;
			}

			.blog {
				display: flex;
				flex-direction: column;
				align-items: center;
				gap: 1rem;
				margin-top: 3rem;
			}

			.more {
				display: flex;
				gap: 1.5rem;
				font-size: 0.95rem;

				a {
					color: var(--muted-color);
					text-decoration: none;
					transition: color 0.2s ease;
				}
				a:hover {
					color: var(--text-color);
				}
			}

			footer {
				display: flex;
				justify-content: space-between;
				align-items: center;
				gap: 1rem;
				padding: 1.5rem 2rem;
				font-size: 0.9rem;
				animation: rise 0.7s 0.3s cubic-bezier(0.2, 0.7, 0.2, 1) both;

				a {
					color: #737373;
					text-decoration: none;
					transition: color 0.2s ease;
				}
				a:hover {
					color: var(--text-color);
				}
			}

			.socials {
				display: flex;
				gap: 1.25rem;
				margin: 0;
				padding: 0;
				list-style: none;

				a {
					display: flex;
				}
				svg {
					width: 1.15rem;
					height: 1.15rem;
				}
			}

			@media screen and (max-width: 480px) {
				footer {
					flex-direction: column-reverse;
				}
			}

			a:focus-visible {
				outline: 2px solid #fff;
				outline-offset: 3px;
			}

			.latest {
				display: flex;
				flex-direction: column;
				gap: 0.2rem;
				max-width: 28rem;
				padding: 0.9rem 1.25rem;
				border: 1px solid var(--border-color);
				border-radius: 0.75rem;
				background-color: rgba(255, 255, 255, 0.03);
				color: inherit;
				text-decoration: none;
				transition:
					background-color 0.2s ease,
					border-color 0.2s ease;
			}
			.latest:hover {
				background-color: rgba(255, 255, 255, 0.07);
				border-color: rgba(255, 255, 255, 0.3);
			}
			.latest-label {
				font-size: 0.8rem;
				color: var(--muted-color);
				text-transform: uppercase;
				letter-spacing: 0.08em;
			}
			.latest-title {
				font-size: 1rem;
				line-height: 1.45;
			}

			@keyframes rise {
				from {
					opacity: 0;
					transform: translateY(12px);
				}
			}

			@media (prefers-reduced-motion: reduce) {
				main > *,
				footer {
					animation: none;
				}
			}
		</style>
	</body>
</html>
